 def _active_fields() -> tuple[str, ...]:
     raw = os.environ.get("FEATURES", "base")
     if raw.strip() in ("", "base"):
         return FIELDS
     return tuple(part.strip() for part in raw.split(",") if part.strip())
 
 
+def _compute_label_stats(
+    rows: list[dict[str, str]],
+) -> tuple[float, dict[str, dict[str, tuple[float, int]]]]:
+    """Compute global label mean and per-category statistics for target encoding."""
+    labels = []
+    stats = {"user_id": {}, "video_id": {}, "author_id": {}}
+    
+    for row in rows:
+        if "long_view" not in row:
+            continue
+        label = float(row["long_view"])
+        labels.append(label)
+        for field in stats:
+            value = row[field]
+            if value not in stats[field]:
+                stats[field][value] = [label, 1]
+            else:
+                stats[field][value][0] += label
+                stats[field][value][1] += 1
+    
+    global_mean = float(np.mean(labels)) if labels else 0.5
+    
+    # Compute means and counts
+    for field in stats:
+        for value in stats[field]:
+            total, count = stats[field][value]
+            stats[field][value] = (total / count, count)
+    
+    return global_mean, stats
+
+
+def _smooth_target_mean(
+    mean: float, count: int, global_mean: float, smoothing: float = 1.0
+) -> float:
+    """Apply Micci-Barreca (2001) smoothing formula to target mean."""
+    return (count * mean + smoothing * global_mean) / (count + smoothing)
+
+
+def _get_target_encoded_token(
+    value: str,
+    field: str,
+    global_mean: float,
+    label_stats: dict[str, dict[str, tuple[float, int]]],
+) -> str:
+    """Get target-encoded categorical token (bucketed). Row's own label excluded via out-of-fold stats."""
+    if field not in label_stats or value not in label_stats[field]:
+        encoded_value = global_mean
+    else:
+        mean, count = label_stats[field][value]
+        encoded_value = _smooth_target_mean(mean, count, global_mean)
+    
+    # Bucket into 20 quantiles for categorical encoding
+    bucket = min(19, max(0, int(np.clip(encoded_value, 0.0, 1.0) * 20)))
+    return f"te_{bucket:02d}"
+
+
+def _augment_rows_with_target_encoding(
+    rows: list[dict[str, str]],
+    global_mean: float,
+    label_stats: dict[str, dict[str, tuple[float, int]]],
+) -> list[dict[str, str]]:
+    """Augment rows with target-encoded features."""
+    augmented = []
+    for row in rows:
+        row_copy = deepcopy(row)
+        row_copy["user_id_te"] = _get_target_encoded_token("user_id", "user_id", global_mean, label_stats)
+        row_copy["video_id_te"] = _get_target_encoded_token("video_id", "video_id", global_mean, label_stats)
+        row_copy["author_id_te"] = _get_target_encoded_token("author_id", "author_id", global_mean, label_stats)
+        augmented.append(row_copy)
+    return augmented
+
