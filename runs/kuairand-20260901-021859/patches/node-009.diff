+def _compute_user_first_seen(rows: list[dict[str, str]]) -> dict[str, str]:
+    """Compute first-seen date for each user from training data."""
+    user_first = {}
+    for row in rows:
+        user_id = row["user_id"]
+        date = row["date"]
+        if user_id not in user_first or date < user_first[user_id]:
+            user_first[user_id] = date
+    return user_first
+
+
+def _compute_days_since_edges(
+    rows: list[dict[str, str]], user_first_seen: dict[str, str], n: int = 10
+) -> np.ndarray:
+    """Compute bucket edges for days since first seen from training data."""
+    days_since_values = []
+    for row in rows:
+        user_id = row["user_id"]
+        if user_id in user_first_seen:
+            first_date = datetime.strptime(user_first_seen[user_id], "%Y-%m-%d")
+            current_date = datetime.strptime(row["date"], "%Y-%m-%d")
+            days_since = (current_date - first_date).days
+            days_since_values.append(float(days_since))
+    return np.quantile(np.asarray(days_since_values, dtype=np.float64), np.linspace(0, 1, n + 1)[1:-1])
+
+
