+            tokens.append(str(date_obj.weekday()))
+        elif name == "days_since_first_seen":
+            first_date_str = user_first_seen.get(row["user_id"], row["date"]) if user_first_seen else row["date"]
+            days_since = (datetime.strptime(row["date"], "%Y-%m-%d") - datetime.strptime(first_date_str, "%Y-%m-%d")).days
+            bucket = int(np.searchsorted(days_since_edges, float(days_since))) if days_since_edges is not None else 0
+            tokens.append(str(bucket))
         else:
             tokens.append(row[name])
     return tokens
