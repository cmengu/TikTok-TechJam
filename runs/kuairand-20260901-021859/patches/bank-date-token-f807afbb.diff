+def _day_of_week(date_str: str) -> str:
+    """Extract day of week from date string (0=Monday, 6=Sunday)."""
+    try:
+        d = datetime.fromisoformat(date_str)
+        return str(d.weekday())
+    except (ValueError, TypeError):
+        return "6"  # Unknown day defaults to Sunday
+
+
+def _compute_user_first_dates(rows: list[dict[str, str]]) -> dict[str, str]:
+    """Compute first seen date for each user from training data only."""
+    first_dates = {}
+    for row in rows:
+        user_id = row["user_id"]
+        date = row.get("date", "")
+        if date and (user_id not in first_dates or date < first_dates[user_id]):
+            first_dates[user_id] = date
+    return first_dates
+
+
+def _days_since_first(date_str: str, first_date_str: str) -> int:
+    """Compute days between current date and user's first seen date."""
+    try:
+        d1 = datetime.fromisoformat(date_str)
+        d2 = datetime.fromisoformat(first_date_str)
+        return (d1 - d2).days
+    except (ValueError, TypeError):
+        return 0
+
+
