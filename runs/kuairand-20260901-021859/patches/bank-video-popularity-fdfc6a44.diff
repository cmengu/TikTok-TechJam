+def _video_stats(rows: list[dict[str, str]]) -> tuple[dict[str, int], dict[str, float]]:
+    """Compute per-video impression count and out-of-fold positive rate.
+    
+    Returns:
+        impressions: video_id -> count of training impressions
+        positive_rates: video_id -> fraction of positive labels
+    """
+    impressions: dict[str, int] = {}
+    positives: dict[str, float] = {}
+    
+    for row in rows:
+        vid = row["video_id"]
+        impressions[vid] = impressions.get(vid, 0) + 1
+        if "long_view" in row:
+            positives[vid] = positives.get(vid, 0.0) + float(row["long_view"])
+    
+    positive_rates = {
+        vid: positives.get(vid, 0.0) / impressions[vid]
+        for vid in impressions
+    }
+    
+    return impressions, positive_rates
+
+
+def _video_popularity_edges(
+    impressions: dict[str, int],
+    positive_rates: dict[str, float],
+    n: int = 10,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Compute quantile edges for video impression count and positive rate."""
+    imp_values = np.asarray(list(impressions.values()), dtype=np.float64)
+    rate_values = np.asarray(list(positive_rates.values()), dtype=np.float64)
+    
+    imp_edges = np.quantile(imp_values, np.linspace(0, 1, n + 1)[1:-1])
+    rate_edges = np.quantile(rate_values, np.linspace(0, 1, n + 1)[1:-1])
+    
+    return imp_edges, rate_edges
+
+
+def _video_popularity_token(
+    video_id: str,
+    impressions: dict[str, int],
+    positive_rates: dict[str, float],
+    imp_edges: np.ndarray,
+    rate_edges: np.ndarray,
+) -> str:
+    """Map video to popularity bucket token.
+    
+    Rare videos (low impression count) share buckets. Frequent videos are
+    further bucketed by positive rate to enable memorization of popular patterns.
+    """
+    imp = float(impressions.get(video_id, 0))
+    rate = positive_rates.get(video_id, 0.5)
+    
+    imp_bucket = int(np.searchsorted(imp_edges, imp))
+    rate_bucket = int(np.searchsorted(rate_edges, rate))
+    
+    return f"vpop_{imp_bucket}_{rate_bucket}"
+
+
