+class DCNv2Model(torch.nn.Module):
+    """DCNv2-style model: embedding + cross layers + MLP + output projection."""
+    
+    def __init__(self, dim: int, embedding_dim: int = 16, num_fields: int = 5, hidden_dim: int = 64):
+        super().__init__()
+        self.embedding = torch.nn.Embedding(dim, embedding_dim)
+        
+        x0_dim = num_fields * embedding_dim
+        
+        # Cross layers: x_{l+1} = x0 * (W_l x_l + b_l) + x_l
+        self.cross_w1 = torch.nn.Linear(x0_dim, x0_dim)
+        self.cross_w2 = torch.nn.Linear(x0_dim, x0_dim)
+        
+        # MLP: 2 layers with hidden dim 64
+        self.mlp = torch.nn.Sequential(
+            torch.nn.Linear(x0_dim, hidden_dim),
+            torch.nn.ReLU(),
+            torch.nn.Linear(hidden_dim, x0_dim)
+        )
+        
+        # Output projection: concatenate cross + MLP outputs and project to logit
+        self.output_proj = torch.nn.Linear(x0_dim * 2, 1)
+    
+    def forward(self, x):
+        # x: (batch_size, num_fields) with token IDs
+        emb = self.embedding(x)  # (batch_size, num_fields, embedding_dim)
+        x0 = emb.reshape(emb.size(0), -1)  # (batch_size, num_fields * embedding_dim)
+        
+        # Cross network (2 layers)
+        x_cross = x0
+        for cross_w in [self.cross_w1, self.cross_w2]:
+            y = cross_w(x_cross)
+            x_cross = x0 * y + x_cross
+        
+        # MLP network
+        x_mlp = self.mlp(x0)
+        
+        # Concatenate and project to logit
+        x_concat = torch.cat([x_cross, x_mlp], dim=1)
+        logits = self.output_proj(x_concat)
+        
+        return logits.squeeze(-1)
 
 
