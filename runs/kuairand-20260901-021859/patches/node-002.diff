+def _compute_video_stats(rows: list[dict[str, str]]) -> tuple[dict[str, int], dict[str, float]]:
+    """Compute per-video impression count and positive rate from training data."""
+    video_counts = {}
+    video_positives = {}
+    
+    for row in rows:
+        vid = row["video_id"]
+        video_counts[vid] = video_counts.get(vid, 0) + 1
+        if "long_view" in row:
+            video_positives[vid] = video_positives.get(vid, 0) + float(row["long_view"])
+    
+    video_pos_rate = {
+        vid: (video_positives.get(vid, 0) / video_counts[vid]) if video_counts[vid] > 0 else 0.0
+        for vid in video_counts
+    }
+    
+    return video_counts, video_pos_rate
+
+
+def _bucket_video_stats(
+    counts: dict[str, int], pos_rates: dict[str, float], n_buckets: int = 10
+) -> tuple[np.ndarray, np.ndarray]:
+    """Compute quantile edges for video count and positive rate bucketing."""
+    count_values = np.asarray(list(counts.values()), dtype=np.float64)
+    rate_values = np.asarray(list(pos_rates.values()), dtype=np.float64)
+    
+    count_edges = np.quantile(count_values, np.linspace(0, 1, n_buckets + 1)[1:-1])
+    rate_edges = np.quantile(rate_values, np.linspace(0, 1, n_buckets + 1)[1:-1])
+    
+    return count_edges, rate_edges
+
+
