+    rate_edges: np.ndarray | None = None,
+) -> list[str]:
     tokens = []
     for name in fields:
         if name == "dur_bucket":
             tokens.append(str(int(np.searchsorted(edges, float(row["duration_ms"])))))
+        elif name == "video_pop_count":
+            if video_counts is not None and count_edges is not None:
+                vid = row["video_id"]
+                count = video_counts.get(vid, 0)
+                bucket = int(np.searchsorted(count_edges, count))
+                tokens.append(f"vc{bucket}")
+            else:
+                tokens.append("vc0")
+        elif name == "video_pop_rate":
+            if video_pos_rate is not None and rate_edges is not None:
+                vid = row["video_id"]
+                rate = video_pos_rate.get(vid, 0.0)
+                bucket = int(np.searchsorted(rate_edges, rate))
+                tokens.append(f"vr{bucket}")
+            else:
+                tokens.append("vr0")
         else:
             tokens.append(row[name])
     return tokens
