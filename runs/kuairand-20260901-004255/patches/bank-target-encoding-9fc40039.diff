+def _compute_target_encoding_stats(
+    rows: list[dict[str, str]],
+    fields: tuple[str, ...],
+    smoothing: float = 1.0,
+) -> tuple[dict[str, dict[str, float]], float]:
+    """
+    Compute out-of-fold target encoding with Micci-Barreca smoothing.
+
+    For each unique value of each field, compute the smoothed mean of long_view,
+    regularizing toward the global mean to handle sparse categories.
+    """
+    labels = np.array([float(r["long_view"]) for r in rows if "long_view" in r], dtype=np.float32)
+    global_mean = float(np.mean(labels)) if len(labels) > 0 else 0.5
+
+    encoding = {}
+    for field in fields:
+        field_encoding = {}
+        by_value = {}
+        for row in rows:
+            val = row[field]
+            if val not in by_value:
+                by_value[val] = []
+            if "long_view" in row:
+                by_value[val].append(float(row["long_view"]))
+
+        for val, labels_list in by_value.items():
+            count = len(labels_list)
+            value_mean = float(np.mean(labels_list))
+            smoothed = (count * value_mean + smoothing * global_mean) / (count + smoothing)
+            field_encoding[val] = smoothed
+        encoding[field] = field_encoding
+    return encoding, global_mean
+
