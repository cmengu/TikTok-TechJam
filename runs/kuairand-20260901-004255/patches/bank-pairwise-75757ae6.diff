+def _group_by_user(rows: list[dict[str, str]]) -> dict[str, list[dict[str, str]]]:
+    """Group rows by user_id."""
+    groups = {}
+    for row in rows:
+        uid = row["user_id"]
+        if uid not in groups:
+            groups[uid] = []
+        groups[uid].append(row)
+    return groups
+
+
+def _sample_pairs(
+    user_groups: dict[str, list[dict[str, str]]], rng: np.random.Generator, batch_size: int
+) -> tuple[list[dict[str, str]], list[dict[str, str]]]:
+    """Sample positive/negative pairs grouped by user for BPR objective.
+    
+    For each user with multiple interactions, sample one positive (long_view=1) 
+    and one negative (long_view=0) item.
+    """
+    pos_rows, neg_rows = [], []
+    for uid, group in user_groups.items():
+        positives = [r for r in group if float(r["long_view"]) > 0.5]
+        negatives = [r for r in group if float(r["long_view"]) <= 0.5]
+        if positives and negatives:
+            for _ in range(min(len(positives), len(negatives), batch_size)):
+                pos_rows.append(rng.choice(positives))
+                neg_rows.append(rng.choice(negatives))
+    return pos_rows, neg_rows
+
