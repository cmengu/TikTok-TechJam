+def _get_encode_fields() -> tuple[str, ...]:
+    """Get fields to apply target encoding to."""
+    raw = os.environ.get("ENCODE", "").strip()
+    if not raw:
+        return ()
+    return tuple(part.strip() for part in raw.split(",") if part.strip())
+
+
+def _compute_target_encoding_stats(
+    rows: list[dict[str, str]],
+    field: str,
+) -> tuple[float, dict[str, tuple[float, int]]]:
+    """Compute target encoding stats: global mean and per-value (sum, count)."""
+    labels = [float(r["long_view"]) for r in rows if "long_view" in r]
+    if not labels:
+        return 0.0, {}
+    global_mean = float(np.mean(labels))
+
+    value_stats = {}
+    for row in rows:
+        value = row.get(field, "")
+        if "long_view" in row:
+            label = float(row["long_view"])
+            if value not in value_stats:
+                value_stats[value] = [0.0, 0]
+            value_stats[value][0] += label
+            value_stats[value][1] += 1
+
+    return global_mean, {k: tuple(v) for k, v in value_stats.items()}
+
+
+def _apply_target_encoding(
+    rows: list[dict[str, str]],
+    field: str,
+    global_mean: float,
+    value_stats: dict[str, tuple[float, int]],
+    lambda_smoothing: float = 1.0,
+    exclude_own_label: bool = False,
+) -> list[float]:
+    """Apply Micci-Barreca smoothing; row's own label never contributes (out-of-fold)."""
+    encodings = []
+    for row in rows:
+        value = row.get(field, "")
+        if value in value_stats:
+            total_sum, total_count = value_stats[value]
+            if exclude_own_label and "long_view" in row:
+                own_label = float(row["long_view"])
+                oof_sum = total_sum - own_label
+                oof_count = total_count - 1
+            else:
+                oof_sum = total_sum
+                oof_count = total_count
+            if oof_count > 0:
+                raw_mean = oof_sum / oof_count
+                smoothed = (oof_count * raw_mean + lambda_smoothing * global_mean) / (oof_count + lambda_smoothing)
+            else:
+                smoothed = global_mean
+            encodings.append(smoothed)
+        else:
+            encodings.append(global_mean)
+    return encodings
+
+
+def _quantize_target_encoding(values: list[float], n_buckets: int = 10) -> list[str]:
+    """Quantize continuous target-encoded values into categorical bucket labels."""
+    if not values:
+        return ["te_unk"] * len(values)
+    values_array = np.asarray(values, dtype=np.float64)
+    quantiles = np.quantile(values_array, np.linspace(0, 1, n_buckets + 1))
+    bucket_ids = np.searchsorted(quantiles[1:-1], values_array)
+    return [f"te_{i}" for i in bucket_ids]
+
