+def _create_bpr_pairs(
+    train_rows: list[dict[str, str]],
+    xtr: np.ndarray,
+    ytr: np.ndarray,
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Create positive/negative pairs for pairwise ranking objective grouped by user."""
+    user_groups = {}
+    for i, (row, y_val) in enumerate(zip(train_rows, ytr)):
+        user_id = row["user_id"]
+        if user_id not in user_groups:
+            user_groups[user_id] = {"pos": [], "neg": []}
+        if y_val > 0:
+            user_groups[user_id]["pos"].append(i)
+        else:
+            user_groups[user_id]["neg"].append(i)
+    pos_indices, neg_indices = [], []
+    for groups in user_groups.values():
+        for pos_idx in groups["pos"]:
+            if not groups["neg"]:
+                continue
+            neg_idx = rng.choice(groups["neg"])
+            pos_indices.append(pos_idx)
+            neg_indices.append(neg_idx)
+    return xtr[np.array(pos_indices, dtype=np.int32)], xtr[np.array(neg_indices, dtype=np.int32)]
+
