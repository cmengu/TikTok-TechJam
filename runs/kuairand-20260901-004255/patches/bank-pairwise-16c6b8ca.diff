+    def step_pairwise(self, X_pos: np.ndarray, X_neg: np.ndarray) -> float:
+        """BPR pairwise ranking step grouped by user."""
+        bsz = len(X_pos)
+        z_pos, e_pos, s_pos = self.logits(X_pos)
+        z_neg, e_neg, s_neg = self.logits(X_neg)
+        
+        z_diff = z_pos - z_neg
+        sig_z_diff = sigmoid(z_diff)
+        
+        g_pos = ((sig_z_diff - 1.0) / bsz).astype(np.float32)
+        g_neg = ((1.0 - sig_z_diff) / bsz).astype(np.float32)
+        
+        gV = np.zeros_like(self.V)
+        gW = np.zeros_like(self.W)
+        np.add.at(gW, X_pos, g_pos[:, None])
+        np.add.at(gV, X_pos, g_pos[:, None, None] * (s_pos[:, None, :] - e_pos))
+        np.add.at(gW, X_neg, g_neg[:, None])
+        np.add.at(gV, X_neg, g_neg[:, None, None] * (s_neg[:, None, :] - e_neg))
+        gV += self.l2 * self.V
+        gW += self.l2 * self.W
+        self.t += 1
+        b1, b2, eps = 0.9, 0.999, 1e-8
+        for P, G, M, Vv in ((self.V, gV, self.mV, self.vV), (self.W, gW, self.mW, self.vW)):
+            M *= b1
+            M += (1 - b1) * G
+            Vv *= b2
+            Vv += (1 - b2) * (G * G)
+            P -= self.lr * (M / (1 - b1**self.t)) / (np.sqrt(Vv / (1 - b2**self.t)) + eps)
+        self.b -= self.lr * (g_pos.sum() + g_neg.sum())
+        return float(-np.mean(np.log(sig_z_diff + 1e-9)))
 
     def predict(self, X: np.ndarray, bs: int = 200_000) -> np.ndarray:
