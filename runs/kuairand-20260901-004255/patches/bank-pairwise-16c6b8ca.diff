+def _make_pairwise_batches(
+    train_rows: list[dict[str, str]],
+    vocabs: list[dict[str, int]],
+    unk: list[int],
+    offsets: np.ndarray,
+    edges: np.ndarray,
+    fields: tuple[str, ...],
+    batch_size: int,
+    rng: np.random.Generator,
+) -> list[tuple[np.ndarray, np.ndarray]]:
+    """Create pairwise batches grouped by user (BPR)."""
+    user_items = {}
+    for row in train_rows:
+        user_id = row["user_id"]
+        if user_id not in user_items:
+            user_items[user_id] = {"pos": [], "neg": []}
+        label = float(row.get("long_view", 0.0))
+        if label > 0.5:
+            user_items[user_id]["pos"].append(row)
+        else:
+            user_items[user_id]["neg"].append(row)
+    pairs_pos, pairs_neg = [], []
+    for user_id, items in user_items.items():
+        for pos_row in items["pos"]:
+            for neg_row in items["neg"]:
+                pairs_pos.append(pos_row)
+                pairs_neg.append(neg_row)
+    if pairs_pos:
+        indices = rng.permutation(len(pairs_pos))
+        pairs_pos = [pairs_pos[i] for i in indices]
+        pairs_neg = [pairs_neg[i] for i in indices]
+    batches = []
+    for i in range(0, len(pairs_pos), batch_size):
+        x_pos, _ = _encode_rows(pairs_pos[i:i+batch_size], vocabs, unk, offsets, edges, fields)
+        x_neg, _ = _encode_rows(pairs_neg[i:i+batch_size], vocabs, unk, offsets, edges, fields)
+        batches.append((x_pos, x_neg))
+    return batches
+
