+def _target_encode_fields() -> tuple[str, ...]:
+    """Parse ENCODE environment variable for target-encoding fields."""
+    raw = os.environ.get("ENCODE", "")
+    if not raw.strip():
+        return ()
+    return tuple(part.strip() for part in raw.split(",") if part.strip())
+
+
+def _compute_target_encodings(
+    rows: list[dict[str, str]],
+    y: np.ndarray,
+    fields_to_encode: tuple[str, ...],
+    smoothing: float = 1.0,
+) -> tuple[dict[str, dict[str, float]], float]:
+    """
+    Compute out-of-fold target encodings with smoothing toward global rate.
+    Citation: Micci-Barreca 2001, A preprocessing scheme for high-cardinality categorical attributes.
+    
+    For each unique value of each field:
+    smoothed_mean = (count * category_mean + smoothing * global_mean) / (count + smoothing)
+    """
+    global_mean = float(y.mean())
+    encodings = {}
+    for field in fields_to_encode:
+        field_encodings = {}
+        groups = {}
+        for i, row in enumerate(rows):
+            val = row[field]
+            groups.setdefault(val, []).append(i)
+        for val, indices in groups.items():
+            category_mean = float(np.mean(y[indices]))
+            smoothed_mean = (len(indices) * category_mean + smoothing * global_mean) / (len(indices) + smoothing)
+            field_encodings[val] = smoothed_mean
+        encodings[field] = field_encodings
+    return encodings, global_mean
+
