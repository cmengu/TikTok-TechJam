+def _prepare_pairwise_data(
+    x: np.ndarray, y: np.ndarray, rng: np.random.Generator
+) -> tuple[np.ndarray, np.ndarray]:
+    """Prepare pairwise training data (BPR): positive items ranked above negative items."""
+    pos_mask = y > 0.5
+    pos_indices = np.where(pos_mask)[0]
+    neg_indices = np.where(~pos_mask)[0]
+
+    if len(pos_indices) == 0 or len(neg_indices) == 0:
+        return np.empty((0, x.shape[1]), dtype=x.dtype), np.empty((0, x.shape[1]), dtype=x.dtype)
+
+    pairs = []
+    for pos_idx in pos_indices:
+        neg_idx = rng.choice(neg_indices)
+        pairs.append((x[pos_idx], x[neg_idx]))
+
+    pos_x = np.array([p[0] for p in pairs], dtype=x.dtype)
+    neg_x = np.array([p[1] for p in pairs], dtype=x.dtype)
+    return pos_x, neg_x
+
