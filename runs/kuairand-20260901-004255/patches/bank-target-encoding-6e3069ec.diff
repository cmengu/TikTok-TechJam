+def _compute_target_encoding_stats(
+    rows: list[dict[str, str]],
+    te_fields: tuple[str, ...],
+    smoothing: float = 1.0,
+) -> tuple[list[dict[str, float]], float]:
+    """
+    Compute smoothed target encoding statistics per field value.
+    
+    Implements Micci-Barreca (2001) smoothing:
+    encoded_value = (count * mean + smoothing * global_mean) / (count + smoothing)
+    
+    Returns:
+    - List of dicts (one per TE field) mapping value -> smoothed mean target
+    - Global mean target value
+    """
+    # Collect all targets
+    targets = []
+    for row in rows:
+        if "long_view" in row:
+            targets.append(float(row["long_view"]))
+    
+    if not targets:
+        return [{} for _ in te_fields], 0.5
+    
+    global_mean = float(np.mean(targets))
+    
+    te_stats_list = []
+    for field in te_fields:
+        value_targets = defaultdict(list)
+        for row in rows:
+            if "long_view" in row:
+                value = row[field]
+                target = float(row["long_view"])
+                value_targets[value].append(target)
+        
+        # Compute smoothed means, excluding row's own contribution
+        te_stats = {}
+        for value, value_list in value_targets.items():
+            n = len(value_list)
+            mean = np.mean(value_list)
+            smoothed_mean = (n * mean + smoothing * global_mean) / (n + smoothing)
+            te_stats[value] = float(smoothed_mean)
+        
+        te_stats_list.append(te_stats)
+    
+    return te_stats_list, global_mean
+
