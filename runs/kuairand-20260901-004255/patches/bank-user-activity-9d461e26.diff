+def _build_activity_edges(
+    rows: list[dict[str, str]], n: int = 8
+) -> tuple[np.ndarray, dict[str, int]]:
+    """Compute activity quantile edges from per-user impression count distribution.
+    
+    Returns:
+        edges: quantile boundaries for binning impression counts
+        user_counts: mapping of user_id to total impressions in training data
+    """
+    user_counts = {}
+    for row in rows:
+        user_counts[row["user_id"]] = user_counts.get(row["user_id"], 0) + 1
+    counts = np.asarray(list(user_counts.values()), dtype=np.float64)
+    edges = np.quantile(counts, np.linspace(0, 1, n + 1)[1:-1])
+    return edges, user_counts
+
+
+def _add_activity_buckets(
+    rows: list[dict[str, str]], user_counts: dict[str, int], activity_edges: np.ndarray
+) -> None:
+    """Add activity_bucket field to each row based on per-user impression quantiles."""
+    for row in rows:
+        count = user_counts.get(row["user_id"], 0)
+        bucket = int(np.searchsorted(activity_edges, float(count)))
+        row["activity_bucket"] = str(bucket)
+
