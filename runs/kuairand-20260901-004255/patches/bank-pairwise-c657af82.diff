+def _create_pairwise_batches_for_user(
+    x: np.ndarray, y: np.ndarray, user_ids: list[str], rng: np.random.Generator
+) -> tuple[np.ndarray, np.ndarray]:
+    """Create pairwise ranking samples grouped by user (BPR).
+    
+    For each user, sample positive/negative pairs and return feature matrices.
+    """
+    unique_users = list(set(user_ids))
+    pairs_x_pos = []
+    pairs_x_neg = []
+    
+    for user_id in unique_users:
+        mask = np.array([uid == user_id for uid in user_ids])
+        user_x = x[mask]
+        user_y = y[mask]
+        
+        pos_indices = np.where(user_y > 0.5)[0]
+        neg_indices = np.where(user_y <= 0.5)[0]
+        
+        if len(pos_indices) == 0 or len(neg_indices) == 0:
+            continue
+        
+        # Sample pairs for this user
+        n_pairs = max(1, min(len(pos_indices), len(neg_indices)))
+        for _ in range(n_pairs):
+            pos_i = rng.choice(pos_indices)
+            neg_i = rng.choice(neg_indices)
+            pairs_x_pos.append(user_x[pos_i])
+            pairs_x_neg.append(user_x[neg_i])
+    
+    if not pairs_x_pos:
+        return np.empty((0, x.shape[1]), dtype=x.dtype), np.empty((0, x.shape[1]), dtype=x.dtype)
+    
+    return np.array(pairs_x_pos, dtype=x.dtype), np.array(pairs_x_neg, dtype=x.dtype)
+
