+def _sample_bpr_pairs(
+    rows: list[dict[str, str]],
+    y: np.ndarray,
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Sample positive/negative pairs grouped by user for BPR ranking loss."""
+    user_groups = {}
+    for i, row in enumerate(rows):
+        uid = row["user_id"]
+        if uid not in user_groups:
+            user_groups[uid] = {"pos": [], "neg": []}
+        if y[i] > 0.5:
+            user_groups[uid]["pos"].append(i)
+        else:
+            user_groups[uid]["neg"].append(i)
+    
+    pos_indices, neg_indices = [], []
+    for uid, groups in user_groups.items():
+        for p_idx in groups["pos"]:
+            n_idx = rng.choice(groups["neg"]) if groups["neg"] else None
+            if n_idx is not None:
+                pos_indices.append(p_idx)
+                neg_indices.append(n_idx)
+    return np.array(pos_indices, dtype=np.int32), np.array(neg_indices, dtype=np.int32)
+
 
