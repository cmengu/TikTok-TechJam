+    def step_bpr(self, X_pos: np.ndarray, X_neg: np.ndarray) -> float:
+        """BPR pairwise ranking step: rank positives higher than negatives."""
+        if len(X_pos) == 0:
+            return 0.0
+        
+        bsz = len(X_pos)
+        z_pos, e_pos, s_pos = self.logits(X_pos)
+        z_neg, e_neg, s_neg = self.logits(X_neg)
+        
+        # Score difference: positive - negative
+        z_diff = z_pos - z_neg
+        # Gradient of -log(sigmoid(z_diff)) w.r.t. z_diff
+        sig_diff = sigmoid(z_diff)
+        g = (sig_diff - 1.0) / bsz  # = -sigmoid(-z_diff) / bsz
+        
+        # Accumulate gradients for embeddings and linear weights
+        gV_pos = np.zeros_like(self.V)
+        gV_neg = np.zeros_like(self.V)
+        gW_pos = np.zeros_like(self.W)
+        gW_neg = np.zeros_like(self.W)
+        
+        np.add.at(gW_pos, X_pos, g[:, None])
+        np.add.at(gW_neg, X_neg, -g[:, None])
+        np.add.at(gV_pos, X_pos, g[:, None, None] * (s_pos[:, None, :] - e_pos))
+        np.add.at(gV_neg, X_neg, -g[:, None, None] * (s_neg[:, None, :] - e_neg))
+        
+        gV = gV_pos + gV_neg + self.l2 * self.V
+        gW = gW_pos + gW_neg + self.l2 * self.W
+        
+        # Adam optimization step
+        self.t += 1
+        b1, b2, eps = 0.9, 0.999, 1e-8
+        for P, G, M, Vv in ((self.V, gV, self.mV, self.vV), (self.W, gW, self.mW, self.vW)):
+            M *= b1
+            M += (1 - b1) * G
+            Vv *= b2
+            Vv += (1 - b2) * (G * G)
+            P -= self.lr * (M / (1 - b1**self.t)) / (np.sqrt(Vv / (1 - b2**self.t)) + eps)
+        self.b -= self.lr * g.sum()
+        
+        return float(-np.mean(np.log(sig_diff + 1e-9)))
+
