+    def step(self, X: np.ndarray, y: np.ndarray, user_ids: np.ndarray) -> float:
+        """Bayesian Personalized Ranking loss: in-batch pairwise ranking grouped by user."""
         gV = np.zeros_like(self.V)
         gW = np.zeros_like(self.W)
+        gb = np.float32(0.0)
+        
+        total_loss = 0.0
+        n_pairs = 0
+        
+        # Group items by user and compute pairwise ranking loss
+        unique_users = np.unique(user_ids)
+        for user in unique_users:
+            mask = user_ids == user
+            X_user = X[mask]
+            y_user = y[mask]
+            
+            # Separate positive and negative items for this user
+            pos_indices = np.where(y_user == 1)[0]
+            neg_indices = np.where(y_user == 0)[0]
+            
+            if len(pos_indices) == 0 or len(neg_indices) == 0:
+                continue
+            
+            X_pos = X_user[pos_indices]
+            X_neg = X_user[neg_indices]
+            
+            z_pos, e_pos, s_pos = self.logits(X_pos)
+            z_neg, e_neg, s_neg = self.logits(X_neg)
+            
+            # Pairwise ranking: BPR loss for each (positive, negative) pair
+            for i in range(len(z_pos)):
+                for j in range(len(z_neg)):
+                    delta = z_pos[i] - z_neg[j]
+                    pred = sigmoid(delta)
+                    loss = -np.log(pred + 1e-9)
+                    
+                    # Gradient: d(loss)/d(delta) = sigmoid(delta) - 1
+                    g_delta = (pred - 1.0).astype(np.float32)
+                    
+                    # Accumulate gradients for positive and negative items
+                    np.add.at(gW, X_pos[i], g_delta)
+                    np.add.at(gV, X_pos[i], g_delta[None] * (s_pos[i:i+1] - e_pos[i:i+1]))
+                    np.add.at(gW, X_neg[j], -g_delta)
+                    np.add.at(gV, X_neg[j], -g_delta[None] * (s_neg[j:j+1] - e_neg[j:j+1]))
+                    
+                    gb += g_delta
+                    total_loss += loss
+                    n_pairs += 1
+        
+        if n_pairs == 0:
+            return 0.0
+        
+        # Average gradients by number of pairs
+        gV /= n_pairs
+        gW /= n_pairs
+        gb /= n_pairs
+        
         gV += self.l2 * self.V
         gW += self.l2 * self.W
         self.t += 1
