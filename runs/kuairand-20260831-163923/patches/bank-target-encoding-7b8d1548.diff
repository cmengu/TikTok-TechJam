+def _compute_target_encodings(
+    rows: list[dict[str, str]],
+    target_fields: tuple[str, ...],
+    label_col: str = "long_view",
+    smoothing: float = 1.0,
+    n_splits: int = 5,
+    seed: int = 0,
+) -> tuple[list[dict[str, float]], float]:
+    """Compute out-of-fold target encodings with smoothing (Micci-Barreca 2001).
+    
+    For each value of target_fields, computes the mean label using out-of-fold
+    cross-validation (row's own label never contributes), smoothed toward global mean.
+    
+    Args:
+        rows: Training rows with labels
+        target_fields: Categorical fields to target encode
+        label_col: Name of label column
+        smoothing: Smoothing strength (count + smoothing in denominator)
+        n_splits: Number of cross-validation folds
+        seed: Random seed for fold assignment
+    
+    Returns:
+        Tuple of (field_encodings, global_mean) where field_encodings[i][value]
+        is the target encoding for field i.
+    """
+    if not rows or label_col not in rows[0]:
+        return [dict() for _ in target_fields], 0.5
+    
+    # Compute global mean
+    labels = np.array([float(r[label_col]) for r in rows], dtype=np.float32)
+    global_mean = float(np.mean(labels))
+    
+    # Assign rows to folds
+    rng = np.random.default_rng(seed)
+    fold_ids = rng.integers(0, n_splits, len(rows))
+    
+    encodings = []
+    for field in target_fields:
+        field_encoding = {}
+        
+        # For each unique value in this field
+        unique_vals = set(r[field] for r in rows)
+        
+        for val in unique_vals:
+            fold_preds = []
+            
+            # For each fold, compute encoding using out-of-fold data
+            for fold_id in range(n_splits):
+                # Get indices where field == val AND fold != fold_id
+                train_indices = [
+                    i for i in range(len(rows))
+                    if rows[i][field] == val and fold_ids[i] != fold_id
+                ]
+                
+                if train_indices:
+                    mean_label = float(np.mean(labels[train_indices]))
+                    count = len(train_indices)
+                    smoothed = (count * mean_label + smoothing * global_mean) / (count + smoothing)
+                else:
+                    smoothed = global_mean
+                
+                fold_preds.append(smoothed)
+            
+            # Average across folds
+            field_encoding[val] = float(np.mean(fold_preds))
+        
+        encodings.append(field_encoding)
+    
+    return encodings, global_mean
+
+
