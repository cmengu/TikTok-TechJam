+def _compute_target_encodings(
+    rows: list[dict[str, str]],
+    fields: tuple[str, ...],
+    edges: np.ndarray,
+    alpha: float = 1.0,
+) -> tuple[dict[tuple[str, str], float], float]:
+    """
+    Compute Laplace-smoothed target encodings per category value.
+    Micci-Barreca 2001: preprocessing scheme for high-cardinality categorical attributes.
+    Returns (encodings mapping (field, value) → smoothed_mean, global_mean).
+    """
+    # Global mean of target label
+    labels = np.array([float(r["long_view"]) for r in rows if "long_view" in r])
+    if len(labels) == 0:
+        return {}, 0.5
+    global_mean = float(np.mean(labels))
+    
+    encodings = {}
+    for field in fields:
+        # Accumulate labels per category value
+        value_stats = defaultdict(lambda: [])
+        for row in rows:
+            if "long_view" not in row:
+                continue
+            
+            if field == "dur_bucket":
+                key = str(int(np.searchsorted(edges, float(row["duration_ms"]))))
+            else:
+                key = row[field]
+            
+            value_stats[key].append(float(row["long_view"]))
+        
+        # Laplace smoothing: (sum + alpha*global_mean) / (count + alpha)
+        for key, vals in value_stats.items():
+            smoothed = (sum(vals) + alpha * global_mean) / (len(vals) + alpha)
+            encodings[(field, key)] = smoothed
+    
+    return encodings, global_mean
+
+
 def sigmoid(x: np.ndarray) -> np.ndarray:
     return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))
 
