+def _compute_target_encodings(
+    rows: list[dict[str, str]],
+    fields: tuple[str, ...],
+    smoothing: float = 1.0,
+) -> dict[str, dict[str, float]]:
+    """
+    Compute out-of-fold target encodings (Micci-Barreca 2001).
+    
+    For each field, compute mean long_view per unique value,
+    smoothed toward global mean. Rows without labels are ignored.
+    """
+    valid_labels = [float(r["long_view"]) for r in rows if "long_view" in r]
+    if not valid_labels:
+        return {f: {} for f in fields}
+    
+    global_mean = float(np.mean(valid_labels))
+    encodings = {}
+    
+    for field in fields:
+        value_stats: dict[str, tuple[float, int]] = {}
+        for row in rows:
+            if "long_view" not in row:
+                continue
+            value = row[field]
+            label = float(row["long_view"])
+            sum_val, count = value_stats.get(value, (0.0, 0))
+            value_stats[value] = (sum_val + label, count + 1)
+        
+        field_encoding = {}
+        for value, (sum_labels, count) in value_stats.items():
+            smoothed_mean = (sum_labels + smoothing * global_mean) / (count + smoothing)
+            field_encoding[value] = float(smoothed_mean)
+        
+        encodings[field] = field_encoding
+    
+    return encodings, global_mean
+
+
+def _apply_target_encodings(rows: list[dict[str, str]], encodings: dict[str, dict[str, float]]) -> None:
+    """Add target-encoded columns to rows in-place."""
+    for row in rows:
+        for field in encodings:
+            encoded = encodings[field].get(row[field], 0.0)
+            row[f"{field}_te"] = str(encoded)
+
