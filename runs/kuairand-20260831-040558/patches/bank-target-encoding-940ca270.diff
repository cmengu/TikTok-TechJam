+def _build_oof_target_encodings(
+    train_rows: list[dict[str, str]],
+    edges: np.ndarray,
+    fields: tuple[str, ...],
+    fold_idx: np.ndarray,
+    fold_id: int,
+) -> tuple[list[dict[str, float]], float]:
+    """Build out-of-fold target encoding statistics.
+    
+    For each field, compute mean target value per category using only out-of-fold rows.
+    """
+    oof_mask = fold_idx != fold_id
+    global_mean = float(np.mean([float(r["long_view"]) for r in train_rows if "long_view" in r]))
+    
+    encodings = [dict() for _ in fields]
+    
+    # Accumulate targets per category in out-of-fold data
+    accums = [defaultdict(list) for _ in fields]
+    for idx, row in enumerate(train_rows):
+        if not oof_mask[idx] or "long_view" not in row:
+            continue
+        target = float(row["long_view"])
+        for i, v in enumerate(_row_tokens(row, fields, edges)):
+            accums[i][v].append(target)
+    
+    # Compute means and store in encoding dicts
+    for i, accum in enumerate(accums):
+        for cat, targets in accum.items():
+            encodings[i][cat] = float(np.mean(targets))
+    
+    return encodings, global_mean
+
+
+def _encode_target(
+    value: str, encoding: dict[str, float], global_mean: float
+) -> float:
+    """Encode a single value using target encoding, defaulting to global mean for unseen."""
+    return encoding.get(value, global_mean)
+
