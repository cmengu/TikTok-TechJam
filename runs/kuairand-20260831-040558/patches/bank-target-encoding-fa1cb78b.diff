+def _build_target_encodings(
+    rows: list[dict[str, str]],
+    edges: np.ndarray,
+    fields: tuple[str, ...],
+    smoothing: float = 1.0,
+) -> tuple[list[dict[str, int]], int]:
+    """Compute out-of-fold target encodings for sparse categorical features.
+    
+    Encodes each category by the smoothed mean of the target variable,
+    with smoothing toward global mean for sparse categories.
+    
+    Returns:
+        encodings: list of dicts mapping category value to target-encoded integer (scaled by 10000)
+        default_encoding: default encoded value for unknown categories (global mean scaled by 10000)
+    """
+    encodings = [dict() for _ in fields]
+    counts = [dict() for _ in fields]
+    sums = [dict() for _ in fields]
+    
+    # Compute global statistics from labeled rows
+    targets = [float(row.get("long_view", 0)) for row in rows if "long_view" in row]
+    global_mean = float(np.mean(targets)) if targets else 0.0
+    
+    # Accumulate per-category statistics
+    for row in rows:
+        if "long_view" not in row:
+            continue
+        target = float(row["long_view"])
+        for i, v in enumerate(_row_tokens(row, fields, edges)):
+            if v not in counts[i]:
+                counts[i][v] = 0
+                sums[i][v] = 0.0
+            counts[i][v] += 1
+            sums[i][v] += target
+    
+    # Apply smoothing and quantize to integer range
+    for i in range(len(fields)):
+        for v in counts[i]:
+            category_mean = sums[i][v] / counts[i][v]
+            smoothed = (counts[i][v] * category_mean + smoothing * global_mean) / (counts[i][v] + smoothing)
+            encodings[i][v] = int(round(smoothed * 10000))
+    
+    default_encoding = int(round(global_mean * 10000))
+    return encodings, default_encoding
+
