+def _build_category_history(
+    rows: list[dict[str, str]], decay_rate: float = 0.9
+) -> dict[str, list[tuple[str, float]]]:
+    """Build weighted category history sequences for each user.
+    
+    Returns a dict mapping user_id to list of (category, weight) tuples.
+    Weights decay exponentially from oldest to newest interaction.
+    """
+    history: dict[str, list[str]] = {}
+    for row in rows:
+        user_id = row["user_id"]
+        if user_id not in history:
+            history[user_id] = []
+        history[user_id].append(row["video_id"])
+    
+    weighted = {uid: [(v, decay_rate ** i) for i, v in enumerate(reversed(hist))] 
+                for uid, hist in history.items()}
+    return weighted
+
