+def _compute_target_encodings(
+    rows: list[dict[str, str]],
+    fields: tuple[str, ...],
+    smoothing: float = 1.0,
+) -> tuple[dict[str, dict[str, float]], float]:
+    """Compute out-of-fold Micci-Barreca target encodings per field.
+
+    For each unique value of field, computes smoothed mean of long_view
+    excluding rows with that value (out-of-fold).
+
+    Args:
+        rows: Training rows with 'long_view' labels
+        fields: Field names to encode
+        smoothing: Regularization parameter lambda
+
+    Returns:
+        ({field: {value: encoding}}, global_mean)
+    """
+    if not rows or "long_view" not in rows[0]:
+        return {f: {} for f in fields}, 0.0
+
+    targets = np.array([float(row["long_view"]) for row in rows])
+    global_mean = float(np.mean(targets))
+
+    encodings = {}
+    for field in fields:
+        field_enc = {}
+        groups = {}
+        for i, row in enumerate(rows):
+            val = row[field]
+            if val not in groups:
+                groups[val] = []
+            groups[val].append(i)
+
+        for val, indices in groups.items():
+            count = len(indices)
+            total = float(np.sum(targets[indices]))
+
+            for row_idx in indices:
+                oof_sum = total - targets[row_idx]
+                oof_count = count - 1
+
+                if oof_count > 0:
+                    oof_mean = oof_sum / oof_count
+                else:
+                    oof_mean = global_mean
+
+                smoothed = (oof_count * oof_mean + smoothing * global_mean) / (oof_count + smoothing)
+                if val not in field_enc:
+                    field_enc[val] = smoothed
+
+        encodings[field] = field_enc
+
+    return encodings, global_mean
+
+
 def sigmoid(x: np.ndarray) -> np.ndarray:
     return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))
 
