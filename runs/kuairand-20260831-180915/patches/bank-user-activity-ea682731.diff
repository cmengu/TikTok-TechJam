+def _user_activity_buckets(
+    rows: list[dict[str, str]], n: int = 8
+) -> tuple[dict[str, str], np.ndarray]:
+    """Count impressions per user and bucket into quantiles."""
+    user_counts: dict[str, int] = {}
+    for row in rows:
+        uid = row["user_id"]
+        user_counts[uid] = user_counts.get(uid, 0) + 1
+    
+    counts = np.array(list(user_counts.values()), dtype=np.float64)
+    edges = np.quantile(counts, np.linspace(0, 1, n + 1)[1:-1])
+    
+    user_buckets = {uid: str(int(np.searchsorted(edges, float(count)))) 
+                    for uid, count in user_counts.items()}
+    return user_buckets, edges
+
+
+def _row_tokens(row: dict[str, str], fields: tuple[str, ...], edges: np.ndarray, user_activity_buckets: dict[str, str] | None = None) -> list[str]:
     tokens = []
     for name in fields:
         if name == "dur_bucket":
             tokens.append(str(int(np.searchsorted(edges, float(row["duration_ms"])))))
+        elif name == "user_activity_bucket":
+            tokens.append(user_activity_buckets.get(row["user_id"], "0") if user_activity_buckets else "0")
         else:
             tokens.append(row[name])
     return tokens
 
 
