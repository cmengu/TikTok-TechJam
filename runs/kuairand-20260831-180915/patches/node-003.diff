+    def _step_bpr(self, X: np.ndarray, y: np.ndarray, user_ids: np.ndarray) -> float:
+        """BPR: in-batch pairwise ranking loss grouped by user."""
+        z, e, s = self.logits(X)
+        
+        # Group indices by user
+        user_groups = {}
+        for idx, uid in enumerate(user_ids):
+            if uid not in user_groups:
+                user_groups[uid] = {'pos': [], 'neg': []}
+            if y[idx] > 0.5:
+                user_groups[uid]['pos'].append(idx)
+            else:
+                user_groups[uid]['neg'].append(idx)
+        
+        gV = np.zeros_like(self.V)
+        gW = np.zeros_like(self.W)
+        total_loss = 0.0
+        pair_count = 0
+        
+        for uid, groups in user_groups.items():
+            for pos_idx in groups['pos']:
+                for neg_idx in groups['neg']:
+                    margin = z[pos_idx] - z[neg_idx]
+                    sig_margin = sigmoid(margin)
+                    
+                    # BPR loss: -log(sigmoid(margin))
+                    loss = -np.log(np.clip(sig_margin, 1e-9, 1.0))
+                    total_loss += loss
+                    pair_count += 1
+                    
+                    # Gradient of -log(sigmoid(margin)) w.r.t. margin
+                    grad_margin = sig_margin - 1.0
+                    
+                    # Accumulate gradients for W
+                    np.add.at(gW, X[pos_idx], grad_margin)
+                    np.add.at(gW, X[neg_idx], -grad_margin)
+                    
+                    # Accumulate gradients for V
+                    np.add.at(gV, X[pos_idx], grad_margin * (s[pos_idx, None] - e[pos_idx]))
+                    np.add.at(gV, X[neg_idx], -grad_margin * (s[neg_idx, None] - e[neg_idx]))
+        
+        if pair_count == 0:
+            return 0.0
+        
+        gV /= pair_count
+        gW /= pair_count
+        gV += self.l2 * self.V
+        gW += self.l2 * self.W
+        self.t += 1
+        b1, b2, eps = 0.9, 0.999, 1e-8
+        for P, G, M, Vv in ((self.V, gV, self.mV, self.vV), (self.W, gW, self.mW, self.vW)):
+            M *= b1
+            M += (1 - b1) * G
+            Vv *= b2
+            Vv += (1 - b2) * (G * G)
+            P -= self.lr * (M / (1 - b1**self.t)) / (np.sqrt(Vv / (1 - b2**self.t)) + eps)
+        
+        return float(total_loss / pair_count)
