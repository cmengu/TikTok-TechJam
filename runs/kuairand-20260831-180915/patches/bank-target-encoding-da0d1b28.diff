+def _compute_target_encodings(
+    rows: list[dict[str, str]],
+    fields_to_encode: tuple[str, ...],
+) -> tuple[float, dict[str, dict[str, tuple[int, float]]]]:
+    """
+    Compute target-encoding statistics using out-of-fold leave-one-out.
+
+    For each field-value pair, computes count and sum of long_view labels.
+    During prediction, OOF encoding excludes the current row's contribution.
+
+    Micci-Barreca 2001: A preprocessing scheme for high-cardinality categorical attributes.
+
+    Args:
+        rows: training rows with long_view label
+        fields_to_encode: field names to target-encode (e.g., user_id, video_id, author_id)
+
+    Returns:
+        global_mean: mean of long_view across all rows
+        stats: dict mapping field -> value -> (count, sum) for OOF computation
+    """
+    labels = np.array([float(row.get("long_view", 0.0)) for row in rows])
+    global_mean = float(np.mean(labels))
+
+    stats = {}
+    for field in fields_to_encode:
+        field_stats = {}
+        for idx, row in enumerate(rows):
+            value = row[field]
+            if value not in field_stats:
+                field_stats[value] = {"count": 0, "sum": 0.0}
+            field_stats[value]["count"] += 1
+            field_stats[value]["sum"] += labels[idx]
+
+        stats[field] = {v: (s["count"], s["sum"]) for v, s in field_stats.items()}
+
+    return global_mean, stats
+
+
+def _encode_target(
+    row_label: float,
+    field_value: str,
+    field_stats: dict[str, tuple[int, float]],
+    global_mean: float,
+    smoothing: float = 1.0,
+) -> float:
+    """
+    Compute smoothed out-of-fold target encoding for a single field value.
+
+    Smooths OOF mean toward global mean: (oof_count * oof_mean + smoothing * global_mean) / (oof_count + smoothing)
+    """
+    if field_value not in field_stats:
+        return global_mean
+
+    count, total_sum = field_stats[field_value]
+    oof_count = count - 1
+    oof_sum = total_sum - row_label
+
+    if oof_count <= 0:
+        return global_mean
+
+    oof_mean = oof_sum / oof_count
+    smoothed = (oof_count * oof_mean + global_mean * smoothing) / (oof_count + smoothing)
+    return float(smoothed)
+
+
+def _encode_validation_target(
+    field_value: str,
+    field_stats: dict[str, tuple[int, float]],
+    global_mean: float,
+    smoothing: float = 1.0,
+) -> float:
+    """Encode validation/test row: all training data is in fold, so use full count."""
+    if field_value not in field_stats:
+        return global_mean
+    count, total_sum = field_stats[field_value]
+    mean = total_sum / count
+    smoothed = (count * mean + global_mean * smoothing) / (count + smoothing)
+    return float(smoothed)
+
