+def _build_vocabs_with_te(
+    train_rows: list[dict[str, str]],
+    edges: np.ndarray,
+    fields: tuple[str, ...],
+    te_fields: tuple[str, ...],
+    global_mean: float,
+) -> tuple[list[dict[str, int]], list[int], np.ndarray]:
+    """Build vocabularies including target-encoding buckets."""
+    vocabs = [dict() for _ in fields]
+    for row in train_rows:
+        for i, v in enumerate(_row_tokens(row, fields, edges)):
+            field_name = fields[i] if i < len(fields) else None
+            if field_name in te_fields:
+                # Populate TE buckets
+                for te_bucket in range(10):
+                    te_key = f"te_bucket_{te_bucket}"
+                    if te_key not in vocabs[i]:
+                        vocabs[i][te_key] = len(vocabs[i])
+            else:
+                if v not in vocabs[i]:
+                    vocabs[i][v] = len(vocabs[i])
+    unk = [len(v) for v in vocabs]
+    field_dims = [len(v) + 1 for v in vocabs]
+    offsets = np.cumsum([0] + field_dims[:-1]).astype(np.int32)
+    return vocabs, unk, offsets
+
