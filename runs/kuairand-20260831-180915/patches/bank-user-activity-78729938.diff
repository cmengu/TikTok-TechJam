+def _user_impression_counts(rows: list[dict[str, str]]) -> dict[str, int]:
+    """Count impressions (rows) per user from training data."""
+    counts = {}
+    for row in rows:
+        user_id = row["user_id"]
+        counts[user_id] = counts.get(user_id, 0) + 1
+    return counts
+
+
+def _user_activity_edges(counts: dict[str, int], n_buckets: int = 8) -> np.ndarray:
+    """Create quantile edges for bucketing user activity levels."""
+    if not counts:
+        return np.array([])
+    impression_counts = list(counts.values())
+    return np.quantile(
+        np.asarray(impression_counts, dtype=np.float64),
+        np.linspace(0, 1, n_buckets + 1)[1:-1]
+    )
+
+
 def _bucket_edges(durations: list[float], n: int = 10) -> np.ndarray:
     return np.quantile(np.asarray(durations, dtype=np.float64), np.linspace(0, 1, n + 1)[1:-1])
 
 
