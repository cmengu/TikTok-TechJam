+    def step_bpr(self, X_pos: np.ndarray, X_neg: np.ndarray) -> float:
+        """Bayesian Personalized Ranking: rank positive items higher than negative items."""
+        bsz = len(X_pos)
+        z_pos, e_pos, s_pos = self.logits(X_pos)
+        z_neg, e_neg, s_neg = self.logits(X_neg)
+        z_diff = z_pos - z_neg
+        sig_diff = sigmoid(z_diff)
+        loss = -np.mean(np.log(sig_diff + 1e-9))
+        g_pos = ((sig_diff - 1.0) / bsz).astype(np.float32)
+        g_neg = ((1.0 - sig_diff) / bsz).astype(np.float32)
+        gV = np.zeros_like(self.V)
+        gW = np.zeros_like(self.W)
+        np.add.at(gW, X_pos, g_pos[:, None])
