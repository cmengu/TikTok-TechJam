+def _group_by_user(
+    rows: list[dict[str, str]], y: np.ndarray
+) -> dict[str, tuple[list[dict[str, str]], np.ndarray]]:
+    """Group rows and labels by user_id."""
+    groups: dict[str, tuple[list[dict[str, str]], list[float]]] = {}
+    for row, label in zip(rows, y):
+        uid = row["user_id"]
+        if uid not in groups:
+            groups[uid] = ([], [])
+        groups[uid][0].append(row)
+        groups[uid][1].append(label)
+    return {uid: (row_list, np.array(labels, dtype=np.float32)) 
+            for uid, (row_list, labels) in groups.items()}
+
+
+def _prepare_bpr_pairs(
+    rows: list[dict[str, str]],
+    y: np.ndarray,
+    rng: np.random.Generator,
+    threshold: float = 0.5,
+    max_pairs_per_user: int = 10,
+) -> tuple[list[dict[str, str]], list[dict[str, str]]]:
+    """Sample BPR pairs (positive, negative) grouped by user."""
+    pos_rows, neg_rows = [], []
+    user_groups = _group_by_user(rows, y)
+    for uid, (user_rows, user_y) in user_groups.items():
+        pos_idx = np.where(user_y > threshold)[0]
+        neg_idx = np.where(user_y <= threshold)[0]
+        if len(pos_idx) == 0 or len(neg_idx) == 0:
+            continue
+        n_pairs = min(len(pos_idx) * len(neg_idx), max_pairs_per_user)
+        for _ in range(n_pairs):
+            pos_rows.append(user_rows[rng.choice(pos_idx)])
+            neg_rows.append(user_rows[rng.choice(neg_idx)])
+    return pos_rows, neg_rows
