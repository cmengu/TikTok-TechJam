+def _sample_user_pairs(xtr: np.ndarray, ytr: np.ndarray, rng: np.random.Generator, batch_size: int = 8192):
+    """Sample pairwise ranking pairs grouped by user for BPR training.
+    
+    Yields batches of (x_pos, x_neg) pairs where positive items have high labels
+    and negative items have low labels, sampled within each user.
+    """
+    user_ids = xtr[:, 0]
+    unique_users = np.unique(user_ids)
+    
+    pairs_x_pos = []
+    pairs_x_neg = []
+    
+    for user_id in unique_users:
+        user_mask = user_ids == user_id
+        user_indices = np.where(user_mask)[0]
+        user_labels = ytr[user_indices]
+        
+        pos_indices = user_indices[user_labels > 0.5]
+        neg_indices = user_indices[user_labels <= 0.5]
+        
+        if len(pos_indices) > 0 and len(neg_indices) > 0:
+            for _ in range(len(pos_indices)):
+                pairs_x_pos.append(xtr[rng.choice(pos_indices)])
+                pairs_x_neg.append(xtr[rng.choice(neg_indices)])
+                
+                if len(pairs_x_pos) >= batch_size:
+                    yield np.array(pairs_x_pos), np.array(pairs_x_neg)
+                    pairs_x_pos, pairs_x_neg = [], []
+    
+    if len(pairs_x_pos) > 0:
+        yield np.array(pairs_x_pos), np.array(pairs_x_neg)
