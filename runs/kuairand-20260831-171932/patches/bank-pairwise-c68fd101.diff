+def _group_by_user(
+    train_rows: list[dict[str, str]], y: np.ndarray
+) -> dict[str, tuple[list[int], list[int]]]:
+    """Group row indices by user into (positive_indices, negative_indices)."""
+    user_groups = {}
+    for idx, row in enumerate(train_rows):
+        user_id = row["user_id"]
+        if user_id not in user_groups:
+            user_groups[user_id] = ([], [])
+        if y[idx] > 0.5:
+            user_groups[user_id][0].append(idx)
+        else:
+            user_groups[user_id][1].append(idx)
+    return user_groups
+
+
+def _sample_pairs(
+    user_groups: dict[str, tuple[list[int], list[int]]], rng, batch_size: int
+) -> tuple[np.ndarray, np.ndarray]:
+    """Sample (positive, negative) pairs grouped by user up to batch_size."""
+    pos_indices, neg_indices = [], []
+    for user_id, (pos_items, neg_items) in user_groups.items():
+        if pos_items and neg_items:
+            n_pairs = min(len(pos_items), batch_size - len(pos_indices))
+            if n_pairs > 0:
+                pos_indices.extend(rng.choice(pos_items, size=n_pairs, replace=True))
+                neg_indices.extend(rng.choice(neg_items, size=n_pairs, replace=True))
+    return np.array(pos_indices, dtype=np.int32), np.array(neg_indices, dtype=np.int32)
+
