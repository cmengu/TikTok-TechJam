+def _user_activity_buckets(rows: list[dict[str, str]], n: int = 8) -> dict[str, int]:
+    """Count impressions per user and bucket them into quantiles."""
+    user_counts = {}
+    for row in rows:
+        user_id = row["user_id"]
+        user_counts[user_id] = user_counts.get(user_id, 0) + 1
+    counts = np.asarray(list(user_counts.values()), dtype=np.float64)
+    edges = np.quantile(counts, np.linspace(0, 1, n + 1)[1:-1])
+    user_buckets = {}
+    for user_id, count in user_counts.items():
+        bucket = int(np.searchsorted(edges, float(count)))
+        user_buckets[user_id] = bucket
+    return user_buckets
