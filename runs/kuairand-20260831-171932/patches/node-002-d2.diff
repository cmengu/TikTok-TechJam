+def _compute_target_encodings(
+    rows: list[dict[str, str]],
+    fields_to_encode: tuple[str, ...] = ("user_id", "video_id", "author_id"),
+    smoothing: float = 1.0,
+) -> tuple[dict[int, dict[str, float]], dict[str, dict[str, float]], float]:
+    """Compute out-of-fold target-encoded means per category, smoothed toward global mean.
+    
+    For each specified field, computes mean long_view for all rows with that
+    field value, excluding the current row itself (out-of-fold). Result is
+    smoothed toward the global mean to regularize rare categories.
+    
+    Based on Micci-Barreca 2001, "A preprocessing scheme for high-cardinality
+    categorical attributes in classification and prediction problems."
+    
+    Args:
+        rows: input rows with optional "long_view" labels
+        fields_to_encode: field names to target-encode
+        smoothing: regularization strength (higher = more smoothing toward global)
+    
+    Returns:
+        row_encodings: {row_idx -> {field -> encoded_value}}
+        field_encodings: {field -> {value -> encoded_value}} for out-of-sample
+        global_mean: global mean label (used when group has < 2 samples)
+    """
+    # Compute global mean from labeled rows
+    labeled_rows = [r for r in rows if "long_view" in r]
+    if not labeled_rows:
+        return {}, {}, 0.5
+    
+    labels = np.array([float(r["long_view"]) for r in labeled_rows], dtype=np.float32)
+    global_mean = float(np.mean(labels))
+    
+    row_encodings = {}
+    field_encodings = {}
+    
+    # Process each field independently
+    for field in fields_to_encode:
+        field_encodings[field] = {}
+        
+        # Group labeled rows by field value
+        groups = defaultdict(lambda: {"indices": [], "sum": 0.0, "count": 0})
+        for n, row in enumerate(rows):
+            if "long_view" in row:
+                value = row[field]
+                label = float(row["long_view"])
+                groups[value]["indices"].append(n)
+                groups[value]["sum"] += label
+                groups[value]["count"] += 1
+        
+        # Compute out-of-fold means for training; in-fold for inference
+        for value, group in groups.items():
+            indices = group["indices"]
+            total = group["sum"]
+            count = group["count"]
+            
+            # For inference: use all samples with this value
+            if count > 0:
+                mean = total / count
+                smoothed_mean = (count * mean + smoothing * global_mean) / (count + smoothing)
+                field_encodings[field][value] = smoothed_mean
+            else:
+                field_encodings[field][value] = global_mean
+            
+            # For training: use out-of-fold (leave-one-out) mean per row
+            if count < 2:
+                # Insufficient data, use global mean
+                for idx in indices:
+                    if idx not in row_encodings:
+                        row_encodings[idx] = {}
+                    row_encodings[idx][field] = global_mean
+            else:
+                for row_idx in indices:
+                    row_label = float(rows[row_idx]["long_view"])
+                    oof_sum = total - row_label
+                    oof_count = count - 1
+                    oof_mean = oof_sum / oof_count
+                    smoothed_mean = (oof_count * oof_mean + smoothing * global_mean) / (oof_count + smoothing)
+                    if row_idx not in row_encodings:
+                        row_encodings[row_idx] = {}
+                    row_encodings[row_idx][field] = smoothed_mean
+    
+    return row_encodings, field_encodings, global_mean
+
+
 def sigmoid(x: np.ndarray) -> np.ndarray:
     return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))
 
