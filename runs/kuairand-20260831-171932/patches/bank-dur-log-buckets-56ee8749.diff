+def _bucket_edges(durations: list[float], n: int = 10) -> np.ndarray:
+    """Compute log-scaled bucket edges for duration discretization.
+    
+    Provides finer resolution under 60s where most videos concentrate."""
+    log_durations = np.log1p(np.asarray(durations, dtype=np.float64))
+    return np.quantile(log_durations, np.linspace(0, 1, n + 1)[1:-1])
