             tokens.append(str(int(np.searchsorted(edges, float(row["duration_ms"])))))
         else:
             tokens.append(row[name])
+    
+    # Add explicit cross-product tokens
+    base_tokens = {name: tokens[i] for i, name in enumerate(fields)}
+    for field1, field2 in cross_features:
+        if field1 in base_tokens and field2 in base_tokens:
+            cross_token = f"{base_tokens[field1]}:{base_tokens[field2]}"
+            tokens.append(cross_token)
+    
     return tokens
 
 
