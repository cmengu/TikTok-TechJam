+def _active_cross_features() -> tuple[tuple[str, str], ...]:
+    raw = os.environ.get("CROSS_FEATURES")
+    if raw is None or raw.strip() in ("default", "all", ""):
+        return CROSS_FEATURES
+    elif raw.strip() in ("none", "false"):
+        return ()
+    else:
+        # Custom specification: comma-separated pairs like "user_id:tab,tab:dur_bucket"
+        pairs = []
+        for pair in raw.split(","):
+            parts = pair.strip().split(":")
+            if len(parts) == 2:
+                pairs.append((parts[0].strip(), parts[1].strip()))
+        return tuple(pairs)
+
