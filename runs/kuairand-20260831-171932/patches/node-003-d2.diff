+    def step_pairwise(self, X_pos: np.ndarray, X_neg: np.ndarray) -> float:
+        """BPR step: maximize score(positive) > score(negative).
+        
+        Bayesian Personalized Ranking (BPR) objective with pairwise ranking loss.
+        For each pair, loss = -log(sigmoid(score_pos - score_neg)).
+        """
+        bsz = len(X_pos)
+        z_pos, e_pos, s_pos = self.logits(X_pos)
+        z_neg, e_neg, s_neg = self.logits(X_neg)
+        
+        # Margin: positive score - negative score
+        margin = z_pos - z_neg
+        
+        # Gradient: d(-log(sigmoid(margin)))/d(margin) = -sigmoid(-margin)
+        sig_margin = sigmoid(margin)
+        g = (sig_margin - 1.0) / bsz
+        
+        gV = np.zeros_like(self.V)
+        gW = np.zeros_like(self.W)
+        
+        # Gradients for positive and negative samples
+        np.add.at(gW, X_pos, g[:, None])
+        np.add.at(gV, X_pos, g[:, None, None] * (s_pos[:, None, :] - e_pos))
+        np.add.at(gW, X_neg, -g[:, None])
+        np.add.at(gV, X_neg, -g[:, None, None] * (s_neg[:, None, :] - e_neg))
+        
+        gV += self.l2 * self.V
+        gW += self.l2 * self.W
+        self.t += 1
+        b1, b2, eps = 0.9, 0.999, 1e-8
+        for P, G, M, Vv in ((self.V, gV, self.mV, self.vV), (self.W, gW, self.mW, self.vW)):
+            M *= b1
+            M += (1 - b1) * G
+            Vv *= b2
+            Vv += (1 - b2) * (G * G)
+            P -= self.lr * (M / (1 - b1**self.t)) / (np.sqrt(Vv / (1 - b2**self.t)) + eps)
+        self.b -= self.lr * g.sum()
+        
+        return float(-np.mean(np.log(sig_margin + 1e-9)))
+
     def predict(self, X: np.ndarray, bs: int = 200_000) -> np.ndarray:
