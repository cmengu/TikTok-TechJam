+def _sample_pairwise_data(
+    rows: list[dict[str, str]],
+    rng: np.random.Generator,
+) -> tuple[list[dict[str, str]], list[dict[str, str]]]:
+    """Sample positive-negative pairs grouped by user for BPR training.
+    
+    Groups rows by user_id, then for each positive item (long_view >= 1),
+    samples a negative item (long_view < 1) from the same user.
+    
+    Returns: (positive_rows, negative_rows) where indices correspond to pairs.
+    """
+    grouped = {}
+    for row in rows:
+        uid = row["user_id"]
+        if uid not in grouped:
+            grouped[uid] = {"pos": [], "neg": []}
+        if float(row.get("long_view", 0)) >= 1.0:
+            grouped[uid]["pos"].append(row)
+        else:
+            grouped[uid]["neg"].append(row)
+    
+    pos_rows, neg_rows = [], []
+    for uid, group in grouped.items():
+        if group["pos"] and group["neg"]:
+            for pos in group["pos"]:
+                neg = group["neg"][rng.integers(0, len(group["neg"]))]
+                pos_rows.append(pos)
+                neg_rows.append(neg)
+    return pos_rows, neg_rows
+
