+def _build_user_activity_buckets(
+    train_rows: list[dict[str, str]], n: int = 8
+) -> dict[str, int]:
+    """Count impressions per user and bucket into quantile bins."""
+    user_counts = {}
+    for row in train_rows:
+        user_id = row["user_id"]
+        user_counts[user_id] = user_counts.get(user_id, 0) + 1
+
+    if not user_counts:
+        return {}
+
+    counts = np.asarray(list(user_counts.values()), dtype=np.float64)
+    edges = np.quantile(counts, np.linspace(0, 1, n + 1)[1:-1])
+
+    user_activity_buckets = {}
+    for user_id, count in user_counts.items():
+        user_activity_buckets[user_id] = int(np.searchsorted(edges, count))
+
+    return user_activity_buckets
