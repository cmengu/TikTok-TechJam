+def _compute_oof_target_encodings(
+    rows: list[dict[str, str]],
+    fields: tuple[str, ...],
+    smoothing: float = TARGET_ENCODE_SMOOTHING,
+) -> tuple[dict[str, np.ndarray], float]:
+    """Compute out-of-fold target encodings based on long_view.
+    
+    For each field, computes per-row encoding as the smoothed mean of long_view
+    for all rows with the same field value, excluding the current row.
+    Implements Micci-Barreca 2001 preprocessing scheme for high-cardinality categoricals.
+    """
+    if not rows or "long_view" not in rows[0]:
+        return {}, 0.5
+    
+    labels = np.array([float(row["long_view"]) for row in rows])
+    global_mean = np.mean(labels)
+    
+    encodings = {}
+    for field in fields:
+        field_enc = np.empty(len(rows), dtype=np.float32)
+        
+        # Group row indices by field value
+        groups = {}
+        for i, row in enumerate(rows):
+            val = row[field]
+            if val not in groups:
+                groups[val] = []
+            groups[val].append(i)
+        
+        # For each row, compute mean excluding itself
+        for val, indices in groups.items():
+            indices_arr = np.array(indices, dtype=np.int32)
+            for row_idx in indices:
+                mask = indices_arr != row_idx
+                other_labels = labels[indices_arr[mask]]
+                other_mean = np.mean(other_labels)
+                count = len(other_labels)
+                
+                # Smooth toward global mean
+                smoothed = (count * other_mean + smoothing * global_mean) / (count + smoothing)
+                field_enc[row_idx] = smoothed
+        
+        encodings[field] = field_enc
+    
+    return encodings, global_mean
+
+
+def _apply_static_target_encodings(
+    rows: list[dict[str, str]],
+    train_rows: list[dict[str, str]],
+    fields: tuple[str, ...],
+    smoothing: float = TARGET_ENCODE_SMOOTHING,
+) -> dict[str, np.ndarray]:
+    """Apply target encodings from train_rows to any rows (e.g., validation)."""
+    if not train_rows or "long_view" not in train_rows[0]:
+        return {}
+    
+    train_labels = np.array([float(row["long_view"]) for row in train_rows])
+    global_mean = np.mean(train_labels)
+    
+    encodings = {}
+    for field in fields:
+        groups = {}
+        for i, row in enumerate(train_rows):
+            val = row[field]
+            if val not in groups:
+                groups[val] = []
+            groups[val].append(i)
+        
+        field_enc = np.empty(len(rows), dtype=np.float32)
+        for i, row in enumerate(rows):
+            val = row[field]
+            if val in groups:
+                val_labels = train_labels[groups[val]]
+                val_mean = np.mean(val_labels)
+                count = len(val_labels)
+                smoothed = (count * val_mean + smoothing * global_mean) / (count + smoothing)
+                field_enc[i] = smoothed
+            else:
+                field_enc[i] = global_mean
+        encodings[field] = field_enc
+    
+    return encodings
+
