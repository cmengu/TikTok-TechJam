+def _user_activity_edges(counts: dict[str, int], n: int = 8) -> np.ndarray:
+    """Compute quantile edges for user activity buckets."""
+    return np.quantile(np.asarray(list(counts.values()), dtype=np.float64), np.linspace(0, 1, n + 1)[1:-1])
+
