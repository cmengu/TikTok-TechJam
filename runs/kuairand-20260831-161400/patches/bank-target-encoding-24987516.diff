+def _compute_target_encoding_stats(
+    rows: list[dict[str, str]],
+    groupby_fields: tuple[str, ...],
+) -> tuple[float, dict[str, dict[str, tuple[float, int]]]]:
+    """Compute target encoding statistics: global mean and per-group (sum, count).
+    
+    Reference: Micci-Barreca 2001, A preprocessing scheme for high-cardinality categorical attributes.
+    """
+    global_sum = 0.0
+    global_count = 0
+    stats = {field: {} for field in groupby_fields}
+
+    for row in rows:
+        if "long_view" not in row:
+            continue
+        label = float(row["long_view"])
+        global_sum += label
+        global_count += 1
+
+        for field in groupby_fields:
+            value = row[field]
+            if value not in stats[field]:
+                stats[field][value] = [0.0, 0]
+            stats[field][value][0] += label
+            stats[field][value][1] += 1
+
+    global_mean = global_sum / global_count if global_count > 0 else 0.5
+
+    # Convert to tuples
+    for field in groupby_fields:
+        for value in stats[field]:
+            stats[field][value] = tuple(stats[field][value])
+
+    return global_mean, stats
+
+
+def _encode_target_encoding(
+    value: str,
+    field: str,
+    stats: dict[str, dict[str, tuple[float, int]]],
+    global_mean: float,
+    smoothing: float = TARGET_ENCODING_SMOOTHING,
+    label: float | None = None,
+) -> float:
+    """Apply target encoding with out-of-fold adjustment.
+    
+    The row's own label never contributes (out-of-fold principle).
+    Smoothed toward global rate using Micci-Barreca formula.
+    """
+    if field not in stats or value not in stats[field]:
+        return global_mean
+
+    total_sum, count = stats[field][value]
+
+    # Out-of-fold: exclude this row's contribution to avoid label leakage
+    if label is not None and count > 0:
+        adjusted_sum = total_sum - label
+        adjusted_count = count - 1
+    else:
+        adjusted_sum = total_sum
+        adjusted_count = count
+
+    # Micci-Barreca smoothing: interpolate toward global mean
+    if adjusted_count > 0:
+        group_mean = adjusted_sum / adjusted_count
+        encoded = (adjusted_count * group_mean + smoothing * global_mean) / (adjusted_count + smoothing)
+    else:
+        encoded = global_mean
+
+    return encoded
+
