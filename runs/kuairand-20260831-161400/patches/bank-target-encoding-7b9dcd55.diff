+def _encode_target_features(
+    rows: list[dict[str, str]],
+    target_fields: tuple[str, ...],
+    smoothing: float = 1.0,
+) -> None:
+    """
+    Add target-encoded features to rows (in-place).
+    Micci-Barreca 2001: out-of-fold mean smoothed toward global rate.
+    Leave-one-out: row's own label doesn't contribute to its encoding.
+    
+    Args:
+        rows: List of data rows to augment
+        target_fields: Categorical field names to encode
+        smoothing: Smoothing constant (default 1.0)
+    """
+    if not rows or "long_view" not in rows[0]:
+        return
+    
+    y_all = np.array([float(r["long_view"]) for r in rows], dtype=np.float32)
+    global_mean = float(np.mean(y_all))
+    
+    # Compute sum and count per (field, value) pair
+    stats = {}
+    for field in target_fields:
+        for row in rows:
+            val = row.get(field)
+            if not val:
+                continue
+            key = (field, val)
+            if key not in stats:
+                stats[key] = {"sum": 0.0, "count": 0}
+            stats[key]["sum"] += float(row["long_view"])
+            stats[key]["count"] += 1
+    
+    # Apply encoding with leave-one-out for each row
+    for row in rows:
+        for field in target_fields:
+            val = row.get(field)
+            key = (field, val)
+            
+            if key not in stats:
+                row[f"te_{field}"] = str(global_mean)
+            else:
+                s, c = stats[key]["sum"], stats[key]["count"]
+                # Leave-one-out: exclude this row's contribution
+                if "long_view" in row:
+                    s -= float(row["long_view"])
+                    c -= 1
+                # Mean with leave-one-out
+                mean = s / c if c > 0 else global_mean
+                # Apply Micci-Barreca smoothing
+                te_val = (c * mean + smoothing * global_mean) / (c + smoothing)
+                row[f"te_{field}"] = str(te_val)
+
+
 def sigmoid(x: np.ndarray) -> np.ndarray:
     return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))
 
