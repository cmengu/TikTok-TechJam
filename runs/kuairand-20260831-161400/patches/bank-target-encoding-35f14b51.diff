+def _compute_target_encodings(
+    rows: list[dict[str, str]],
+    te_fields: tuple[str, ...] = ("user_id", "video_id", "author_id"),
+    label_field: str = "long_view",
+    smoothing: float = 1.0,
+) -> tuple[np.ndarray, float]:
+    """
+    Compute out-of-fold target encoding using Micci-Barreca (2001) smoothing.
+    
+    For each row and field: compute the mean of label_field grouped by that field's value,
+    excluding the current row (out-of-fold). Smooth the estimate toward the global mean.
+    
+    Args:
+        rows: List of row dictionaries from CSV
+        te_fields: Field names to apply target encoding to
+        label_field: Name of label column
+        smoothing: Laplace smoothing strength
+    
+    Returns:
+        - te_encodings: shape (n_rows, len(te_fields)), dtype float32
+        - global_mean: global mean used for smoothing
+    """
+    # Extract labels
+    labels = np.array([float(r.get(label_field, 0.0)) for r in rows], dtype=np.float32)
+    
+    # Compute global mean (only over rows with labels)
+    has_label = np.array([label_field in r for r in rows])
+    if np.any(has_label):
+        global_mean = np.mean(labels[has_label])
+    else:
+        global_mean = np.float32(0.5)
+    
+    # Precompute group statistics for each field
+    field_stats = {}
+    for field in te_fields:
+        field_stats[field] = {}
+        for i, row in enumerate(rows):
+            val = row.get(field, "")
+            if val not in field_stats[field]:
+                field_stats[field][val] = {"sum": np.float32(0.0), "count": 0}
+            if label_field in row:
+                field_stats[field][val]["sum"] += labels[i]
+                field_stats[field][val]["count"] += 1
+    
+    # Compute out-of-fold target encodings
+    te_encodings = np.zeros((len(rows), len(te_fields)), dtype=np.float32)
+    
+    for i, row in enumerate(rows):
+        for j, field in enumerate(te_fields):
+            val = row.get(field, "")
+            stats = field_stats[field].get(val, {"sum": np.float32(0.0), "count": 0})
+            
+            # Out-of-fold: exclude current row's contribution if it has a label
+            count = stats["count"]
+            total = stats["sum"]
+            if label_field in row:
+                count = max(0, count - 1)
+                total = total - labels[i]
+            
+            # Compute smoothed mean (Laplace smoothing toward global mean)
+            if count > 0:
+                mean = total / count
+            else:
+                mean = global_mean
+            
+            smoothed = (count * mean + smoothing * global_mean) / (count + smoothing)
+            te_encodings[i, j] = smoothed
+    
+    return te_encodings, global_mean
+
+
+def _discretize_encodings(values: np.ndarray, n_buckets: int = 10) -> np.ndarray:
+    """Discretize continuous values into quantile-based buckets."""
+    quantiles = np.quantile(values, np.linspace(0, 1, n_buckets + 1)[1:-1])
+    return np.searchsorted(quantiles, values).astype(np.int32)
+
