+def _calculate_target_encoding_stats(
+    rows: list[dict[str, str]], fields: tuple[str, ...]
+) -> dict[str, dict[str, dict]]:
+    """Calculate target encoding statistics per field value.
+    
+    For each value in the specified fields, computes:
+    - sum: sum of long_view labels
+    - count: number of occurrences with labels
+    
+    Used to smooth per-value means toward global rate.
+    Implements Micci-Barreca (2001) leave-one-out encoding.
+    """
+    stats = {}
+    for field in fields:
+        stats[field] = {}
+        for row in rows:
+            if "long_view" not in row:
+                continue
+            value = row[field]
+            label = float(row["long_view"])
+            if value not in stats[field]:
+                stats[field][value] = {"sum": 0.0, "count": 0}
+            stats[field][value]["sum"] += label
+            stats[field][value]["count"] += 1
+    return stats
+
+
+def _apply_target_encoding(
+    rows: list[dict[str, str]],
+    fields: tuple[str, ...],
+    target_stats: dict[str, dict[str, dict]],
+    global_mean: float,
+    smoothing: float = 1.0,
+) -> np.ndarray:
+    """Apply target-encoded features, smoothed toward global rate.
+    
+    For each row and field, replaces categorical value with:
+        smoothed_mean = (n * mean + m * global_mean) / (n + m)
+    
+    where n=count, mean=per-value mean, m=smoothing factor.
+    Implements Micci-Barreca (2001) smoothing with leave-one-out.
+    """
+    encoded = np.zeros((len(rows), len(fields)), dtype=np.float32)
+    for row_idx, row in enumerate(rows):
+        for field_idx, field in enumerate(fields):
+            value = row[field]
+            if value in target_stats[field]:
+                total_sum = target_stats[field][value]["sum"]
+                total_count = target_stats[field][value]["count"]
+                
+                # Leave-one-out: exclude this row's contribution if it has a label
+                if "long_view" in row:
+                    label = float(row["long_view"])
+                    total_sum -= label
+                    total_count -= 1
+                
+                if total_count > 0:
+                    mean = total_sum / total_count
+                else:
+                    mean = global_mean
+            else:
+                mean = global_mean
+                total_count = 0
+            
+            # Apply smoothing toward global rate
+            smoothed_mean = (
+                total_count * mean + smoothing * global_mean
+            ) / (total_count + smoothing)
+            encoded[row_idx, field_idx] = smoothed_mean
+    
+    return encoded
+
+
