# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# Secrets and local config
.env
.env.*

# Run artefacts: every run directory except the placeholder
# runs/: bulky artefacts (attempts/ checkpoints, workspace/ nested git) stay
# local; the judge-readable record of every run is committed.
runs/*
!runs/.gitkeep
!runs/*/
runs/*/*
!runs/*/events.jsonl
!runs/*/lessons.jsonl
!runs/*/heartbeat.jsonl
!runs/*/iterations.jsonl
!runs/*/submission*.csv
!runs/*/patches/
!runs/*/patches/**

# Data caches (parquet, raw Ali-CCP) — never committed
data/cache/
data/raw/
data/kuairand/
*.parquet
*.csv

# KuaiRand-Pure dataset (downloaded, never committed)
starter_kit/KuaiRand-Pure/
starter_kit/*.tar.gz

# OS / editor
.DS_Store
.idea/
.vscode/

# Submission video build artefacts (typography cards + renders)
video/cards/

# One-shot codemods (applied locally; delete after branch merges)
scripts/patch_*.py
scripts/apply_*.py
data/raw
pytest_full*.txt
